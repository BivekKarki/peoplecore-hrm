# PostgreSQL Database
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/peoplecore_hrm

# Auth - generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_NAME=PeopleCore HRM
NODE_ENV=development

# Email (optional — uses Ethereal test SMTP in dev if not set)
# For Gmail: enable 2FA → App Passwords → generate password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=PeopleCore HRM <noreply@yourcompany.com>
HR_ADMIN_EMAIL=hr@yourcompany.com

# AI Features (Claude claude-sonnet-4-20250514)
ANTHROPIC_API_KEY=sk-ant-your-key-here
GEMINI_API_KEY=AQ.Ab8RN6IjmTql6-IzshqoLm9MGGkHC1DAQR57gsHubBaDeOIjXA


# File Storage (optional - defaults to local disk in dev)
# For production use S3 or Cloudflare R2:
STORAGE_BACKEND=local
S3_BUCKET=peoplecore-documents
S3_REGION=auto
S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your-key-id
S3_SECRET_ACCESS_KEY=your-secret-key
